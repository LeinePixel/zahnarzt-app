# Supabase development project (EU region, synthetic data only)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# Secret: CLI seed process only. Never expose in browser code or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key

# Local seed credentials: choose unique strong values; never commit real passwords.
SEED_REZEPTION_PASSWORD=replace-with-a-local-password
SEED_BEHANDLER_PASSWORD=replace-with-a-local-password
SEED_PRAXISADMIN_PASSWORD=replace-with-a-local-password
