create function pg_temp.query_is_true(p_sql text)
returns boolean
language plpgsql
as $$
declare
  v_result boolean;
begin
  execute p_sql into v_result;
  return coalesce(v_result, false);
exception
  when others then
    return false;
end;
$$;

create function pg_temp.query_text(p_sql text)
returns text
language plpgsql
as $$
declare
  v_result text;
begin
  execute p_sql into v_result;
  return v_result;
exception
  when others then
    return null;
end;
$$;

